---
import Base from '../../layouts/Base.astro';
import Prompt from '../../components/Prompt.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts } from '../../lib/posts';
import { collectTags, tagSlug } from '../../lib/tags';
import { TAG_ALIASES } from '../../../scripts/lib/migrate.mjs';
const tags = collectTags(await getPublishedPosts());
// Legacy Jekyll anchors (#k8s, #aad, ...) that alias normalisation folded into another tag.
const legacy: Record<string, string> = { ...TAG_ALIASES, 'Kube-node_shell': 'Kube-node_shell' };
const aliasIds = new Map<string, string[]>();
for (const [from, to] of Object.entries(legacy)) {
  const a = from === 'Kube-node_shell' ? 'kube-node_shell' : tagSlug(from);
  const target = tagSlug(to);
  if (a !== target && tags.some((t) => t.slug === target)) aliasIds.set(target, [...(aliasIds.get(target) ?? []), a]);
}
---
<Base title="Tags">
  <Prompt cmd="ls tags/" />
  <p class="tag-cloud mono">{tags.map((t) => <a class="tag" href={`#${t.slug}`}>#{t.slug}<sup class="muted">{t.posts.length}</sup></a>)}</p>
  {tags.map((t) => (
    <section>
      {(aliasIds.get(t.slug) ?? []).map((id) => <span id={id}></span>)}
      <h2 id={t.slug} class="mono"><a href={`/tags/${t.slug}/`}>#{t.slug}</a></h2>
      <PostList posts={t.posts} />
    </section>
  ))}
</Base>
